{$DOMAIN} {
    encode zstd gzip
    @immutable path /assets/*
    @publicAsset path /fonts/* /anatomy/*
    @document path / /index.html
    handle /api/* {
        header Cache-Control "private, no-store"
        reverse_proxy api:8000
    }
    handle /telegram/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle {
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        header @publicAsset Cache-Control "public, max-age=86400"
        header @document Cache-Control "public, max-age=0, must-revalidate"
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
